@startuml
title Food Delivery Platform - Use Case Diagram (Release 1 / MVP)

left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "Customer" as A_Customer
actor "Restaurant Partner" as A_Restaurant
actor "Shipper (Delivery Personnel)" as A_Shipper
actor "System Administrator" as A_Admin

actor "VNPay" as A_VNPay
actor "Maps / Geocoding API" as A_Maps
actor "Push Notification Provider\n(APNs / FCM)" as A_Push
actor "OAuth Provider\n(Google / Apple)" as A_OAuth

rectangle "Food Delivery Platform (MVP)" as SYS {

  package "Customer" {
    usecase "UC-01 Register / Login" as UC01
    usecase "UC-02 Browse / Search Restaurants" as UC02
    usecase "UC-03 Search / Filter Food Items\n(Category + Proximity)" as UC03
    usecase "UC-04 View Restaurant / Item Availability" as UC04

    usecase "UC-05 Manage Shopping Cart" as UC05
    usecase "UC-06 Enforce Single-Restaurant Cart" as UC06

    usecase "UC-07 Validate Delivery Address" as UC07
    usecase "UC-08 Check Service Area (MVP)" as UC08
    usecase "UC-09 Check Restaurant Delivery Radius" as UC09

    usecase "UC-10 Checkout / Place Order" as UC10
    usecase "UC-11 Select Payment Method" as UC11

    usecase "UC-12 Process Payment" as UC12
    usecase "UC-12a Pay by COD" as UC12A
    usecase "UC-12b Pay via VNPay" as UC12B
    usecase "UC-13 Confirm VNPay Payment" as UC13

    usecase "UC-14 Receive Real-time Order Updates" as UC14
    usecase "UC-15 Push Notification (Background)" as UC15
    usecase "UC-16 WebSocket Status Update (Foreground)" as UC16
  }

  package "Restaurant Partner" {
    usecase "UC-20 Manage Menu Items" as UC20
    usecase "UC-21 Control Availability\n(Item / Restaurant)" as UC21

    usecase "UC-22 Receive New Order Alert" as UC22
    usecase "UC-23 Accept / Reject Order" as UC23
    usecase "UC-24 Update Preparation Status\n(Preparing / Ready for Pickup)" as UC24
    usecase "UC-25 Cancel Order with Reason" as UC25
  }

  package "Shipper" {
    usecase "UC-30 Toggle Availability" as UC30
    usecase "UC-31 Accept Delivery Job" as UC31
    usecase "UC-32 Confirm Pickup" as UC32
    usecase "UC-33 Confirm Delivery" as UC33
  }

  package "Admin" {
    usecase "UC-40 Admin Sign-in + RBAC" as UC40

    usecase "UC-41 Approve / Reject\nRestaurant & Shipper Applications" as UC41
    usecase "UC-42 Search User Accounts" as UC42
    usecase "UC-43 Suspend / Reactivate Partners" as UC43

    usecase "UC-44 Monitor Platform Health" as UC44
    usecase "UC-45 Monitor Orders & View Details" as UC45
    usecase "UC-46 Cancel Order with Reason" as UC46

    usecase "UC-47 Configure Commission %\n(+ Change History)" as UC47
    usecase "UC-48 View Reports" as UC48
    usecase "UC-49 Export Report (CSV)" as UC49

    usecase "UC-50 Write Immutable Audit Log" as UC50
  }

  package "Platform / Internal" {
    usecase "UC-60 Enforce Order Lifecycle Integrity" as UC60
    usecase "UC-61 Validate State Transition" as UC61

    usecase "UC-62 Route Order to Restaurant" as UC62
    usecase "UC-63 Dispatch / Assign Shipper" as UC63

    usecase "UC-64 Calculate GMV & Commission" as UC64
  }
}

' ===== Actor associations =====
A_Customer -- UC01
A_Customer -- UC02
A_Customer -- UC03
A_Customer -- UC04
A_Customer -- UC05
A_Customer -- UC07
A_Customer -- UC10
A_Customer -- UC14

A_Restaurant -- UC20
A_Restaurant -- UC21
A_Restaurant -- UC22
A_Restaurant -- UC23
A_Restaurant -- UC24
A_Restaurant -- UC25

A_Shipper -- UC30
A_Shipper -- UC31
A_Shipper -- UC32
A_Shipper -- UC33

A_Admin -- UC40
A_Admin -- UC41
A_Admin -- UC42
A_Admin -- UC43
A_Admin -- UC44
A_Admin -- UC45
A_Admin -- UC46
A_Admin -- UC47
A_Admin -- UC48

A_VNPay -- UC13
A_Maps -- UC07
A_Push -- UC15
A_OAuth -- UC01

' ===== Includes / Extends / Generalization =====

' Cart integrity
UC05 .> UC06 : <<include>>

' Deliverability checks
UC07 .> UC08 : <<include>>
UC07 .> UC09 : <<include>>

' Item search depends on location/proximity checks
UC03 .> UC07 : <<include>>

' Checkout includes validations and payment selection
UC10 .> UC05 : <<include>>
UC10 .> UC07 : <<include>>
UC10 .> UC11 : <<include>>
UC10 .> UC12 : <<include>>

' Payment specialization
UC12 <|-- UC12A
UC12 <|-- UC12B

' VNPay confirmation (gateway callback)
UC12B .> UC13 : <<include>>

' After order placement, platform routes and dispatches
UC10 .> UC62 : <<include>>
UC23 .> UC63 : <<include>>

' Order lifecycle integrity enforced on every status change
UC23 .> UC60 : <<include>>
UC24 .> UC60 : <<include>>
UC25 .> UC60 : <<include>>
UC32 .> UC60 : <<include>>
UC33 .> UC60 : <<include>>
UC60 .> UC61 : <<include>>

' Real-time updates: foreground WebSocket + background push
UC14 .> UC16 : <<include>>
UC14 .> UC15 : <<include>>

' Commission calculation: triggered when order is delivered
UC33 .> UC64 : <<include>>

' Reports include export
UC48 .> UC49 : <<include>>
UC48 .> UC64 : <<include>>

' Audit log included in privileged admin operations
UC41 .> UC50 : <<include>>
UC43 .> UC50 : <<include>>
UC46 .> UC50 : <<include>>
UC47 .> UC50 : <<include>>
UC48 .> UC50 : <<include>>

@enduml
